@{
    ViewData["Title"] = "Change Password";
    var forced = ViewBag.Forced as bool? ?? false;
}

<div class="premium-form-card" style="max-width: 500px; margin: 0 auto;">
    <div class="premium-form-header">
        <div class="avatar-icon">
            <i class="bi bi-shield-lock"></i>
        </div>
        <div>
            <h2>Change Password</h2>
            <p>@(forced ? "You must set a new password before you can use the admin pages." : "Update your admin password.")</p>
        </div>
    </div>

    <form asp-action="ChangePassword" method="post">
        <div class="premium-form-body">
            @if (ViewData["Error"] is string error)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }

            <div class="mb-3">
                <label for="currentPassword" class="form-label">Current Password</label>
                <input type="password" name="currentPassword" id="currentPassword" class="form-control" autocomplete="current-password" required />
            </div>

            <div class="mb-3">
                <label for="newPassword" class="form-label">New Password</label>
                <input type="password" name="newPassword" id="newPassword" class="form-control" autocomplete="new-password" required minlength="@FaceAttendanceSystem.Services.AdminBootstrapper.MinAdminPasswordLength" />
                <div class="form-text">At least @FaceAttendanceSystem.Services.AdminBootstrapper.MinAdminPasswordLength characters, different from your username.</div>
            </div>

            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm New Password</label>
                <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" autocomplete="new-password" required />
            </div>
        </div>

        <div class="premium-form-footer">
            @if (forced)
            {
                <button type="submit" form="logoutForm" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-right me-1"></i>Log out</button>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Cancel</a>
            }
            <button type="submit" class="btn btn-primary"><i class="bi bi-key me-1"></i>Change Password</button>
        </div>
    </form>

    <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="d-none"></form>
</div>
