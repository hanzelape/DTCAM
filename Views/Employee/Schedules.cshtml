@{
    ViewData["Title"] = "My Schedules";
    Layout = "_EmployeeLayout";
}

<div class="page-header">
    <div>
        <h1 class="page-title">My Schedules</h1>
        <p class="page-subtitle">Activities assigned to you, with the schedule window and location required for check-in.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (ViewBag.Schedules != null && ((List<FaceAttendanceSystem.Models.Schedule>)ViewBag.Schedules).Any())
        {
            <div class="premium-table-wrapper">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Activity</th>
                            <th scope="col">Date</th>
                            <th scope="col">Start Time</th>
                            <th scope="col">End Time</th>
                            <th scope="col">Location</th>
                            <th scope="col">Repeat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in (List<FaceAttendanceSystem.Models.Schedule>)ViewBag.Schedules)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@schedule.Title</span>
                                    @if (!string.IsNullOrEmpty(schedule.Description))
                                    {
                                        <br /><small class="text-muted">@schedule.Description</small>
                                    }
                                </td>
                                <td>@schedule.Date.ToString("MMM dd, yyyy")</td>
                                <td>@DateTime.Today.Add(schedule.StartTime).ToString("hh:mm tt")</td>
                                <td>@DateTime.Today.Add(schedule.EndTime).ToString("hh:mm tt")</td>
                                <td>@schedule.Location</td>
                                <td>@schedule.RepeatType</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="bi bi-calendar-x d-block mb-2" style="font-size:1.75rem;color:var(--color-beige);"></i>
                <p class="text-muted mb-0">No schedules assigned yet.</p>
            </div>
        }
    </div>
</div>
