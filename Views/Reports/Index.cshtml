@model FaceAttendanceSystem.ViewModels.AttendanceReportViewModel

@{
    ViewData["Title"] = "Attendance Reports";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Attendance Reports</h1>
        <p class="page-subtitle">Filter attendance records by date, employee, schedule, and status.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExportCsv"
           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
           asp-route-employeeId="@Model.EmployeeId"
           asp-route-scheduleId="@Model.ScheduleId"
           asp-route-status="@Model.Status"
           class="btn btn-primary"><i class="bi bi-filetype-csv"></i> Export CSV</a>
    </div>
</div>

<div class="premium-form-card mb-4">
    <div class="premium-form-header">
        <div class="avatar-icon">
            <i class="bi bi-funnel"></i>
        </div>
        <div>
            <h2>Filters</h2>
            <p>Refine the report before viewing or exporting results.</p>
        </div>
    </div>

    <form method="get" asp-action="Index" class="premium-form-body row g-3">
        <div class="col-6 col-md-2">
            <label class="form-label" for="startDate">Start Date</label>
            <input type="date" id="startDate" name="startDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="endDate">End Date</label>
            <input type="date" id="endDate" name="endDate" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="employeeId">Employee</label>
            <select id="employeeId" name="employeeId" class="form-select">
                <option value="">All</option>
                @foreach (var p in ViewBag.Employees)
                {
                    <option value="@p.Value" selected="@(Model.EmployeeId?.ToString() == p.Value)">@p.Text</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="scheduleId">Schedule</label>
            <select id="scheduleId" name="scheduleId" class="form-select">
                <option value="">All</option>
                @foreach (var s in ViewBag.Schedules)
                {
                    <option value="@s.Value" selected="@(Model.ScheduleId?.ToString() == s.Value)">@s.Text</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="status">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="">All</option>
                <option value="Early" selected="@(Model.Status == "Early")">Early</option>
                <option value="On Time" selected="@(Model.Status == "On Time")">On Time</option>
                <option value="Late" selected="@(Model.Status == "Late")">Late</option>
            </select>
        </div>
        <div class="col-6 col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-primary flex-fill"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
        </div>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card text-center text-white bg-primary h-100">
            <div class="card-body">
                <h5 class="card-title">Total Present</h5>
                <div class="stat-value">@Model.TotalPresent</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center text-white bg-info h-100">
            <div class="card-body">
                <h5 class="card-title">Early</h5>
                <div class="stat-value">@Model.TotalEarly</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center text-white bg-success h-100">
            <div class="card-body">
                <h5 class="card-title">On Time</h5>
                <div class="stat-value">@Model.TotalOnTime</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center text-white bg-warning h-100">
            <div class="card-body">
                <h5 class="card-title">Late</h5>
                <div class="stat-value">@Model.TotalLate</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center text-white bg-primary h-100">
            <div class="card-body">
                <h5 class="card-title">Attendance Rate</h5>
                <div class="stat-value">@Model.AttendanceRate.ToString("0.0")%</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center text-white bg-danger h-100">
            <div class="card-body">
                <h5 class="card-title">Absenteeism Rate</h5>
                <div class="stat-value">@Model.AbsenteeismRate.ToString("0.0")%</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center text-white bg-warning h-100">
            <div class="card-body">
                <h5 class="card-title">Late Rate</h5>
                <div class="stat-value">@Model.LateRate.ToString("0.0")%</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-center bg-light h-100">
            <div class="card-body">
                <h5 class="card-title">Absent</h5>
                <div class="stat-value">@Model.AbsentCount</div>
            </div>
        </div>
    </div>
</div>

<h2 class="section-title">Records</h2>

<div class="premium-table-wrapper">
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Date / Time</th>
                <th scope="col">Employee</th>
                <th scope="col">Schedule</th>
                <th scope="col">Status</th>
                <th scope="col">Detection Reliability</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Records.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No records match the selected filters.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Records)
                {
                    <tr>
                        <td>@item.TimeRecorded.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td class="fw-semibold">@item.Employee?.FullName</td>
                        <td>@item.Schedule?.Title</td>
                        <td><partial name="_StatusBadge" model="@item.Status" /></td>
                        <td>@(item.ConfidenceScore > 0 ? (item.ConfidenceScore * 100).ToString("0.0") + "%" : "N/A")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
