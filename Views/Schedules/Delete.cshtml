@model FaceAttendanceSystem.Models.Schedule

@{
    ViewData["Title"] = "Delete Schedule";
}

<div class="premium-form-card" style="max-width: 640px; margin: 0 auto;">
    <div class="premium-form-header">
        <div class="avatar-icon">
            <i class="bi bi-calendar-x"></i>
        </div>
        <div>
            <h2>Delete Schedule</h2>
            <p>This action cannot be undone.</p>
        </div>
    </div>

    <div class="premium-form-body">
        <div class="alert alert-warning">
            <strong>Are you sure you want to delete this schedule?</strong>
        </div>

        <div class="premium-section-card mb-3">
            <div class="premium-section-body">
                <h5 class="fw-bold mb-2">@Model.Title</h5>
                <p class="text-muted mb-2">@Model.Description</p>
                <div class="text-muted" style="font-size: 0.9rem;">
                    <strong class="text-secondary">Date:</strong> @Model.Date.ToString("MMM dd, yyyy")<br />
                    <strong class="text-secondary">Time:</strong> @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")<br />
                    <strong class="text-secondary">Location:</strong> @Model.Location<br />
                    <strong class="text-secondary">Repeat:</strong> @(Model.RepeatType == FaceAttendanceSystem.Models.ScheduleRepeatType.None ? "None" : Model.RepeatType.ToString())<br />
                    <strong class="text-secondary">Grace Period:</strong> @Model.LateGracePeriodMinutes minutes
                </div>
            </div>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="premium-form-footer">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Cancel</a>
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete Schedule</button>
    </form>
</div>
