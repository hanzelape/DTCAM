# ASP.NET (/opt/faceattendance/.env)
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3306;Database=face_attendance_db;User ID=faceapp;Password=CHANGE_ME;SslMode=Preferred
FaceRecognition__ApiUrl=http://127.0.0.1:5000
# Shared secret sent as X-Api-Key. Must equal FACE_API_KEY below.
# Generate with: openssl rand -hex 32
FaceRecognition__ApiKey=CHANGE_ME_LONG_RANDOM_SECRET

# First admin account. Only used when the admins table is empty; the password
# must be changed at first login. Remove Admin__InitialPassword afterwards.
Admin__InitialUsername=admin
Admin__InitialPassword=CHANGE_ME_AT_LEAST_10_CHARS

# Python FastAPI (/opt/faceattendance/face-recognition-api/.env)
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=info
# Required; the service refuses to start without it (min 16 chars).
FACE_API_KEY=CHANGE_ME_LONG_RANDOM_SECRET
# Optional liveness tuning (defaults shown)
# LIVENESS_FRONTAL_MAX_OFFSET=0.10
# LIVENESS_TURNED_MIN_OFFSET=0.22
# LIVENESS_SAME_PERSON_MIN_SIMILARITY=0.40
# LIVENESS_MIN_VALID_FRAMES=4
