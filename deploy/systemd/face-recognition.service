[Unit]
Description=Face Recognition FastAPI Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/faceattendance/face-recognition-api
Environment="PATH=/opt/faceattendance/face-recognition-api/venv/bin"
EnvironmentFile=/opt/faceattendance/face-recognition-api/.env
ExecStart=/opt/faceattendance/face-recognition-api/venv/bin/uvicorn main:app --host 127.0.0.1 --port 5000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
